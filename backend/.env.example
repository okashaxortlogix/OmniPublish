APP_NAME="OmniPublish"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================================================
# Database Configuration (PostgreSQL Production / SQLite Local Development)
# =========================================================================
# For Local Development (SQLite):
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

# For Production (PostgreSQL 16+):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=omnipublish_prod
# DB_USERNAME=omnipublish_app
# DB_PASSWORD=your_secure_db_password
# DB_SSLMODE=prefer
# DB_SCHEMA=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# =========================================================================
# Asynchronous Queue & Worker Configuration (Redis / Database)
# =========================================================================
# For Local Development:
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=660

# For Production (Redis):
# QUEUE_CONNECTION=redis
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=publishing
# REDIS_QUEUE_RETRY_AFTER=660
# REDIS_QUEUE_BLOCK_FOR=5

# =========================================================================
# Cache Store (Redis / Database)
# =========================================================================
# For Local Development:
CACHE_STORE=database

# For Production:
# CACHE_STORE=redis

# =========================================================================
# Redis Connectivity (Standalone / ElastiCache / Redis Cluster)
# =========================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# =========================================================================
# Object Storage (AWS S3, Cloudflare R2, MinIO, or Local Public)
# =========================================================================
# For Local Development:
FILESYSTEM_DISK=public

# For Production (AWS S3 / Cloudflare R2):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=omnipublish-media-prod
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@omnipublish.com"
MAIL_FROM_NAME="${APP_NAME}"

# OAuth Platform API Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback/youtube

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/oauth/callback/tiktok

# =========================================================================
# Meta / Facebook & Instagram Graph API Configuration
# =========================================================================
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8001/api/v1/oauth/facebook/callback
# Graph API Host & Version (Safe default: https://graph.facebook.com and v21.0)
META_GRAPH_HOST=https://graph.facebook.com
META_GRAPH_API_VERSION=v21.0

# =========================================================================
# LinkedIn Marketing & Community API Configuration
# =========================================================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8001/api/v1/oauth/linkedin/callback

# =========================================================================
# X (Twitter) Developer API v2 Configuration
# =========================================================================
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:8001/api/v1/oauth/twitter/callback

# =========================================================================
# Pinterest Developer API v5 Configuration
# =========================================================================
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8001/api/v1/oauth/pinterest/callback

# =========================================================================
# Video Processing Engine (FFmpeg & FFprobe)
# =========================================================================
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
MEDIA_MAX_DURATION_SECONDS=43200
MEDIA_MAX_WIDTH=4096
MEDIA_MAX_HEIGHT=4096
MEDIA_MAX_PROCESSING_SECONDS=300

